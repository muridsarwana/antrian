$(document).ready(function() {
  var previousValues = {};
  var soundPlaying = false; // flag to indicate whether a sound is playing

  // reload PHP files every second
  setInterval(function() {
    $('#gts_1').load('gts.php', function(response, status, xhr) {
      var currentValue = $(this).text();
      if (previousValues['gts_1'] !== currentValue) {
        if (!soundPlaying) { // check if a sound is not already playing
          playSound('audio/test_sound.mp3');
          previousValues['gts_1'] = currentValue;
          soundPlaying = true; // set the flag to true
        }
      }
    });

    $('#gts_2').load('gts2.php', function(response, status, xhr) {
      var currentValue = $(this).text();
